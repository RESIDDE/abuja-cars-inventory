# Supabase project credentials (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# OPTIONAL, DEVELOPMENT ONLY.
#
# VIN photo reading normally runs in the `decode-vin` edge function, which
# holds the OpenRouter key server-side:
#
#   npx supabase secrets set OPENROUTER_API_KEY=sk-or-...
#   npx supabase functions deploy decode-vin
#
# Setting the key below instead lets you try the feature before deploying.
# It is only ever read when import.meta.env.DEV is true, so it cannot reach a
# production build — but anything VITE_* is readable by every visitor, so never
# rely on this path for a deployed site.
# ---------------------------------------------------------------------------
# VITE_OPENROUTER_API_KEY=sk-or-...
# VITE_OPENROUTER_MODEL=qwen/qwen3-vl-235b-a22b-instruct
